{
	"name": "dokploy",
	"private": true,
	"workspaces": [
		"apps/api",
		"apps/dokploy",
		"apps/schedules",
		"packages/server"
	],
	"scripts": {
		"dokploy:setup": "bun run --filter './apps/dokploy' setup",
		"dokploy:dev": "bun run --filter './apps/dokploy' dev",
		"dokploy:build": "bun run --filter './apps/dokploy' build",
		"dokploy:start": "bun run --filter './apps/dokploy' start",
		"test": "bun run --filter './apps/dokploy' test",
		"server:script": "bun run --filter './packages/server' switch:dev",
		"server:dev": "bun run --filter './packages/server' dev",
		"server:build": "bun run --filter './packages/server' build",
		"docker:build:canary": "./apps/dokploy/docker/build.sh canary",
		"typecheck": "bun run --filter '*' typecheck",
		"build": "bun run --filter '*' build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "bun run --filter './apps/dokploy' generate:openapi"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/node": "^26.1.1",
		"dotenv": "17.4.2",
		"esbuild": "0.28.1",
		"lint-staged": "^17.0.8",
		"tsx": "4.23.0"
	},
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": "^24.4.0",
		"bun": ">=1.3.14"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3"
	},
	"overrides": {
		"@prisma/config>effect": "3.21.4",
		"@prisma/dev>@hono/node-server": "1.19.14",
		"better-auth": "1.6.23",
		"drizzle-orm": "0.45.2",
		"esbuild": "0.28.1",
		"h3": "1.15.11",
		"hono": "4.12.28",
		"js-yaml": "4.2.0",
		"lodash": "4.18.1",
		"postcss": "8.5.16",
		"vite": "8.1.3"
	}
}
