{
	"name": "@dokploy/api",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "PORT=4000 tsx watch src/index.ts",
		"dev:inngest": "npx --yes inngest-cli@1.9.0 dev -u http://localhost:4000/api/inngest --no-discovery",
		"build": "rimraf dist && tsc --project tsconfig.json",
		"start": "node dist/apps/api/src/index.js",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@dokploy/server": "workspace:*",
		"@hono/node-server": "^1.19.17",
		"@hono/zod-validator": "0.7.6",
		"dotenv": "^18.0.5",
		"hono": "^4.13.12",
		"inngest": "4.21.1",
		"pino": "9.14.0",
		"pino-pretty": "11.3.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"redis": "4.7.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"rimraf": "6.1.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "^24.4.0",
		"bun": ">=1.4.2"
	}
}
