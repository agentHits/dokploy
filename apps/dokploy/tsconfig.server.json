{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "ESNext",
		"outDir": "dist/",
		"target": "ESNext",
		"isolatedModules": false,
		"noEmit": false,
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./*"],
			// Without this the package root resolves to the built dist while deep
			// imports resolve to src, and builds bundle both copies of the server.
			"@dokploy/server": ["../../packages/server/src/index.ts"],
			"@dokploy/server/*": ["../../packages/server/src/*"]
		}
	},
	"include": ["next-env.d.ts", "./server/**/*"]
}
